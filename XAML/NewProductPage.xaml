<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="XAML.NewProductPage"
             Title="NewProductPage">
    <Grid Padding="20">
        <!-- Definicja wierszy sietki grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Nagluwek -->
        <Label
            Grid.Row="0"
            Text="Nowy produkt"
            HorizontalOptions="Center" />

        <VerticalStackLayout Grid.Row="1" Spacing="16">

            <!-- Entry nazwa -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Nazwa" />

                <Entry
                    x:Name="Nazwa"
                    HeightRequest="45"
                    Placeholder="Wpisz nazwę produktu" />
            </VerticalStackLayout>

            <!-- Entry cena -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Cena" />

                <Entry
                    x:Name="Cena"
                    HeightRequest="45"
                    Placeholder="0"
                    Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Selektor kategorii -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="Kategoria" />

                <Picker x:Name="KategoriaPicker">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Procesory</x:String>
                            <x:String>Płyte główne</x:String>
                            <x:String>Telifony</x:String>
                            <x:String>Karty Graficzne</x:String>
                            <x:String>Dyski SSD</x:String>
                            <x:String>Pamięci RAM</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- Swich -->
            <HorizontalStackLayout>
                <Switch x:Name="AwaliableSwtich" HeightRequest="45" />
                <Label Text="Produkt dostępny" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Przycisk -->
        <Button
            Grid.Row="5"
            Text="Dodaj produkt"
            VerticalOptions="End"
            HeightRequest="50" />
    </Grid>


